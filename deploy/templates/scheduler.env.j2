TOKEN={{ token }}
USERNAME={{ username }}
WEBHOOKS_ENABLE=True
WEBHOOKS_PORT=8073
WEBHOOKS_LISTEN=0.0.0.0

APP_ID={{ lookup('env', 'APP_ID') }}
APP_HASH={{ lookup('env', 'APP_HASH') }}

MONGO_HOST={{ mongo_host }}
MONGO_DB=sophie
MONGO_ALLOW_INDEX_DROPPING=False
MONGO_SKIP_INDEXES=True
RUN_MIGRATIONS_ON_STARTUP=False

INSTANCE_NAME=scheduler

MEMORY_DEBUG=False

MODULES_NOT_LOAD=[]

REDIS_HOST=host.containers.internal
REDIS_USERNAME={{ redis_username }}
REDIS_PASSWORD={{ redis_password }}
REDIS_PORT=6379
REDIS_DB_FSM=1

OWNER_ID=483808054
OPERATORS={{ operators | to_json }}

ENVIRONMENT={{ 'production-beta' if role == 'production' else 'staging-beta' }}
SENTRY_URL={{ sentry_url }}
SENTRY_TRACES_SAMPLE_RATE={{ sentry_traces_sample_rate }}

TAVILY_API_KEY={{ tavily_key }}
KAGI_API_KEY={{ kagi_key }}
TINYFISH_API_KEY={{ tinyfish_key }}
{% if antispam_cas_api_key %}
ANTISPAM_CAS_API_KEY={{ antispam_cas_api_key }}
{% endif %}
{% if antispam_cas_export_url %}
ANTISPAM_CAS_EXPORT_URL={{ antispam_cas_export_url }}
{% endif %}
{% if antispam_ofd_url %}
ANTISPAM_OFD_URL={{ antispam_ofd_url }}
{% if antispam_ofd_api_key %}
ANTISPAM_OFD_API_KEY={{ antispam_ofd_api_key }}
{% endif %}
ANTISPAM_OFD_NAME={{ antispam_ofd_name }}
{% if antispam_ofd_web_url %}
ANTISPAM_OFD_WEB_URL={{ antispam_ofd_web_url }}
{% endif %}
{% endif %}
{% if antispam_ofd_servers %}
ANTISPAM_OFD_SERVERS={{ antispam_ofd_servers | to_json }}
{% endif %}
