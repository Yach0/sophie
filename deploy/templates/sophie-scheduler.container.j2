[Unit]
Description=Sophie Scheduler
# Only the backing stores, matching sophie-rest. Requires= propagates stop, so depending on the
# bot containers took the scheduler down whenever either bot was stopped or redeployed.
Requires=mongo.service redis.service

[Service]
Restart=always

[Container]
ContainerName=scheduler
Image={{ lookup('ansible.builtin.env','IMAGE_NAME', default='registry.gitlab.com/sophiebot/sophie') }}:{{ image_tag }}
PublishPort=8073:8073
Volume=/var/sophie/data:/data:rw,z
PodmanArgs=--memory=1G
Environment=MODE=scheduler
EnvironmentFile=/var/sophie/scheduler.env
HealthCmd=python -m sophie_bot.healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Install]
WantedBy=multi-user.target default.target
