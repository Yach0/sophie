{
  "name": "sophie-debugger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "i18n:update": "ttag update locales/en.po src",
    "i18n:compile": "ttag po2json locales/en.po > src/i18n/en.json"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ttag": "^1.8.12"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-ttag": "^1.8.16",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "ttag-cli": "^1.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
