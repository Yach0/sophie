# Python cache
__pycache__/
*.py[cod]
*.pyc

# Config
data/config.env

# Runtime logs (purged on every start/reload)
data/runtime.logs

# Ansible inv
data/*.yaml

# Virtual envirment
.venv/

# IDEs
.vscode/
.idea/

# AI Agents love to create those files
*.txt
.*.md
.codex

# Note: .junie/ is intentionally NOT ignored. The JetBrains junie-gitlab-wrapper
# runs `git add -A ':!.junie'` in CI; git aborts (exit 1) if `.junie` is gitignored,
# even with that exclude pathspec, which crashes the run. The wrapper excludes
# `.junie` itself, so it is never committed regardless.

# Localization
sophie.mo

# Test coverage results
allure_results/

# Build
output/

# OpenAPI
openapi.json

# Libs
libs/

*.egg-info/

# Local agent worktree metadata
.claude/worktrees/
